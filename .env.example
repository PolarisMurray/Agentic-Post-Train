# 复制成 .env 再填真实值：  cp .env.example .env && chmod 600 .env
# .env 已在 .gitignore 中忽略，不会被提交。已经 export 的环境变量优先于 .env。
#
# Copy to .env and fill in real values. .env is git-ignored.
# Variables already set in the shell take precedence over .env.

# API key for the endpoint below (DeepSeek key: https://platform.deepseek.com/api_keys)
OPENAI_API_KEY=

# Any OpenAI-compatible endpoint, e.g.
#   DeepSeek:      https://api.deepseek.com
#   OpenAI:        https://api.openai.com/v1
#   Moonshot/Kimi: https://api.moonshot.cn/v1
#   local vLLM:    http://localhost:8000/v1
OPENAI_BASE_URL=https://api.deepseek.com

# Default model name, can be overridden with -model / --model
# DeepSeek: deepseek-flash, deepseek-v4-pro (thinking mode is on by default)
AGENT_MODEL=deepseek-flash
